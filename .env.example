# Copy to .env for local development. Never commit .env or real credentials.
ENVIRONMENT=development
BENCH_ID=LOCAL_BENCH
JROC_CAM_HOST=127.0.0.1
JROC_CAM_PORT=8787
JROC_CAM_MOCK=true
JROC_CAM_DB=data/bench_sessions.sqlite3
JROC_CAM_API_HOST=127.0.0.1
JROC_CAM_API_PORT=8000
JROC_CAM_ALLOW_REMOTE_MODELS=false
JROC_CAM_MODEL_CONFIG=config/model_endpoints.json
JROC_CAM_ENABLE_CORS=false
# Generate a random server-side API key of at least 32 characters; never embed in frontend.
# JROC_CAM_SERVER_API_KEY=
# Set explicit origins only if enabling CORS.
# JROC_CAM_CORS_ORIGINS=http://localhost:5173
# Local Docker Compose PostgreSQL. Set a unique strong password before starting Docker.
# Required by docker-compose.yml; do not commit your real .env file.
# POSTGRES_PASSWORD=
# Optional PostgreSQL connection, not required by the current API outside Docker.
# DATABASE_URL=
# Stripe webhook secret is only for the separate optional webhook API.
# STRIPE_WEBHOOK_SECRET=
# Optional AES-GCM vault key; keep outside source control.
# JROC_CAM_VAULT_KEY=
